 code/qcommon/vm_x86.c      | 775 +++++++++++++++++++++++++++++++------
 8 files changed, 928 insertions(+), 142 deletions(-)

diff --git a/code/asm/common_x64.asm b/code/asm/common_x64.asm
index 366f675daf..16a7002aed 100644
--- a/code/asm/common_x64.asm
+++ b/code/asm/common_x64.asm
@@ -58,4 +58,10 @@ CPUID_EX PROC
 	ret
 CPUID_EX ENDP
 
+; input: RCX - &fpucw
+Q_fpucw PROC
+	fnstcw word ptr [rcx]
+	ret
+Q_fpucw ENDP
+
 END
